# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development
# SQLite file location. On hosting, point this at a persistent disk, e.g. /var/data/qm.db
DB_PATH=./data/qm.db
# Folder for payment screenshots (also needs a persistent disk in production)
UPLOAD_DIR=./uploads
# First admin account, created at startup if missing. Choose a strong password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Commission percent on delivered orders
COMMISSION_RATE=5
